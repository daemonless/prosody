# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.pkg.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="prosody"
ARG PACKAGES="${PKG_NAME}"

LABEL org.opencontainers.image.title="Prosody" \
      org.opencontainers.image.description="Lightweight XMPP chat server, easy to set up and extend." \
      org.opencontainers.image.source="https://github.com/daemonless/prosody" \
      org.opencontainers.image.url="https://prosody.im/" \
      org.opencontainers.image.documentation="https://prosody.im/doc" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Network" \
      io.daemonless.port="5222" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.pkg-name="${PKG_NAME}"

# Retarget the package's sample config at /config and the console; plain
# "*console" logs at debug, which prints every chat message. prosodyctl only
# reads the default path, so that links to the file in /config.
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app /defaults && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    { \
      echo 'data_path = "/config/data"'; \
      echo 'pidfile = "/config/data/prosody.pid"'; \
      echo 'prosody_user = "bsd"'; \
      echo 'prosody_group = "bsd"'; \
      sed \
        -e '/info = "prosody.log"/d' \
        -e '/error = "prosody.err"/d' \
        -e 's|-- "\*console";.*|{ levels = { min = "info" }, to = "console" };|' \
        -e 's|^certificates = "certs"|certificates = "/config/certs"|' \
        -e 's|^VirtualHost "localhost"|VirtualHost(Lua.os.getenv("XMPP_DOMAIN") or "localhost")|' \
        /usr/local/etc/prosody/prosody.cfg.lua.sample; \
    } > /defaults/prosody.cfg.lua && \
    ln -sf /config/prosody.cfg.lua /usr/local/etc/prosody/prosody.cfg.lua && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY root/ /
RUN chmod +x /daemonless/libexec/prosody /daemonless/init.d/* /healthz

CMD ["/daemonless/libexec/prosody"]

EXPOSE 5222 5269 5280 5281
VOLUME /config