#!/bin/sh
# First boot: the config, and a self-signed certificate so clients can use TLS.
set -e

domain="${XMPP_DOMAIN:-localhost}"
mkdir -p /config/data /config/certs

if [ ! -f /config/prosody.cfg.lua ]; then
    cp /defaults/prosody.cfg.lua /config/prosody.cfg.lua
fi

if [ ! -f "/config/certs/$domain.crt" ]; then
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -keyout "/config/certs/$domain.key" -out "/config/certs/$domain.crt" \
        -subj "/CN=$domain" -addext "subjectAltName=DNS:$domain" 2>/dev/null
    chmod 600 "/config/certs/$domain.key"
    echo "[prosody] Created a self-signed certificate for $domain"
fi

if [ "$(id -u)" = 0 ]; then
    chown -R bsd:bsd /config
fi
